// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------------
// 1. USERS, ACCOUNTS, SESSIONS (Authentication & Authorization)
// -------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // Only for credentials provider
  phone         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts             Account[]
  sessions             Session[]
  customer             CustomerProfile?
  addresses            Address[]
  orders               Order[]
  reviews              Review[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  cartItems            CartItem[]
  inventoryMovements   InventoryMovement[]
  orderStatusHistories OrderStatusHistory[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CATALOG_MANAGER
  INVENTORY_MANAGER
  ORDER_MANAGER
  CUSTOMER_SUPPORT
  MARKETING_MANAGER
  ACCOUNTS
  CUSTOMER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String // e.g., "oauth", "credentials"
  provider          String // "google", "facebook", "credentials"
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------------
// 2. CUSTOMER PROFILE & ADDRESSES
// -------------------------------------------------------------------

model CustomerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique // One profile per user
  defaultAddressId String?  @unique // unique to enforce one-to-one
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress Address?       @relation("DefaultAddress", fields: [defaultAddressId], references: [id])
  wishlist       WishlistItem[]
  // Removed `addresses Address[]` because Addresses are linked to User directly,
  // and there's no opposite relation. This avoids validation error.
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultFor     CustomerProfile? @relation("DefaultAddress")
  ordersShipping Order[]          @relation("ShippingAddress")
  ordersBilling  Order[]          @relation("BillingAddress")
}

// -------------------------------------------------------------------
// 3. CATALOG: CATEGORIES, BRANDS, COLLECTIONS, PRODUCTS, VARIANTS
// -------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  prefix      String?  @unique // 2-digit code for barcode generation
  parentId    String?
  image       String?
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  banner      String?
  description String?
  active      Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products ProductCollection[]
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  description      String?
  shortDescription String?
  brandId          String
  categoryId       String
  status           ProductStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand       Brand               @relation(fields: [brandId], references: [id])
  category    Category            @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  media       Media[]
  reviews     Review[]
  collections ProductCollection[]
  tags        ProductTag[]
}

enum ProductStatus {
  DRAFT
  PENDING
  ACTIVE
  INACTIVE
  ARCHIVED
}

model ProductTag {
  productId String
  tag       String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, tag])
}

model ProductCollection {
  productId    String
  collectionId String

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Media {
  id        String    @id @default(cuid())
  productId String
  url       String // Cloudinary URL or external URL
  altText   String?
  type      MediaType @default(IMAGE)
  sortOrder Int       @default(0)
  primary   Boolean   @default(false)
  mobileUrl String? // Optional separate mobile-optimized image

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantMedias VariantMedia[]
}

enum MediaType {
  IMAGE
  VIDEO
}

// -------------------------------------------------------------------
// 4. ATTRIBUTES & VARIANTS
// -------------------------------------------------------------------

model AttributeGroup {
  id        String  @id @default(cuid())
  name      String // e.g., "Size", "Color", "Material"
  code      String  @unique // machine-readable, e.g., "size", "color"
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  values AttributeValue[]
}

model AttributeValue {
  id        String  @id @default(cuid())
  groupId   String
  value     String // e.g., "M", "Blue"
  code      String? // normalized code for barcode (e.g., "0038")
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  group    AttributeGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  variants VariantAttribute[]
}

model ProductVariant {
  id        String        @id @default(cuid())
  productId String
  sku       String        @unique
  barcode   String?       @unique // 12-digit barcode
  price     Decimal       @db.Decimal(10, 2)
  salePrice Decimal?      @db.Decimal(10, 2)
  costPrice Decimal?      @db.Decimal(10, 2)
  weight    Decimal?      @db.Decimal(10, 3) // in kg
  isDefault Boolean       @default(false)
  status    ProductStatus @default(ACTIVE) // can be inactive separately from product
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  product       Product            @relation(fields: [productId], references: [id])
  attributes    VariantAttribute[]
  inventories   Inventory[] // one-to-many with Inventory
  cartItems     CartItem[]
  orderItems    OrderItem[]
  media         VariantMedia[]
  wishlistItems WishlistItem[]
}

model VariantAttribute {
  variantId        String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
}

model VariantMedia {
  variantId String
  mediaId   String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media   Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([variantId, mediaId])
}

// -------------------------------------------------------------------
// 5. INVENTORY & WAREHOUSES
// -------------------------------------------------------------------

model Warehouse {
  id      String  @id @default(cuid())
  name    String
  address String?
  active  Boolean @default(true)

  inventory Inventory[]
}

model Inventory {
  id           String   @id @default(cuid())
  variantId    String
  warehouseId  String
  quantity     Int      @default(0)
  reserved     Int      @default(0) // reserved for pending orders
  reorderLevel Int      @default(5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  movements InventoryMovement[]

  @@unique([variantId, warehouseId]) // composite unique
}

model InventoryMovement {
  id             String   @id @default(cuid())
  inventoryId    String
  quantityChange Int // positive or negative
  reason         String // e.g., "order_placed", "adjustment", "return"
  referenceId    String? // order or adjustment ID
  userId         String? // admin user who made the adjustment
  createdAt      DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
}

// -------------------------------------------------------------------
// 6. ORDERS, ITEMS, PAYMENTS, SHIPMENTS
// -------------------------------------------------------------------

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String
  status            OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus @default(UNPAID)
  subtotal          Decimal       @db.Decimal(10, 2)
  discount          Decimal       @default(0) @db.Decimal(10, 2)
  shipping          Decimal       @default(0) @db.Decimal(10, 2)
  tax               Decimal       @default(0) @db.Decimal(10, 2)
  total             Decimal       @db.Decimal(10, 2)
  couponCode        String?
  shippingAddressId String
  billingAddressId  String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  couponId        String?
  coupon          Coupon?              @relation(fields: [couponId], references: [id])
  customer        User                 @relation(fields: [userId], references: [id])
  shippingAddress Address              @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?             @relation("BillingAddress", fields: [billingAddressId], references: [id])
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  shipment        Shipment?
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PACKED
  READY_FOR_PICKUP
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
  PARTIALLY_REFUNDED
  PAYMENT_FAILED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  variantId   String
  productName String // snapshot of product name
  variantName String // snapshot of variant attributes (e.g., "Blue / M")
  sku         String
  barcode     String?
  price       Decimal @db.Decimal(10, 2) // snapshot of unit price
  quantity    Int
  total       Decimal @db.Decimal(10, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String? // user who performed the action
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  provider      String // e.g., "sslcommerz", "manual"
  transactionId String?       @unique
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(UNPAID)
  method        String? // "card", "bkash", "cash", "bank_transfer"
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CourierProvider {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // e.g., "steadfast", "pathao"
  apiKey    String?
  apiSecret String?
  baseUrl   String?
  settings  Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]
}

model Shipment {
  id                String   @id @default(cuid())
  orderId           String   @unique
  courierProviderId String?
  consignmentId     String?
  trackingNumber    String?
  status            String   @default("pending") // internal status
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierProvider CourierProvider? @relation(fields: [courierProviderId], references: [id])
}

// -------------------------------------------------------------------
// 7. COUPONS, PROMOTIONS, REVIEWS, NOTIFICATIONS
// -------------------------------------------------------------------

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(10, 2) // percentage or fixed amount
  minSpend    Decimal?   @db.Decimal(10, 2)
  maxDiscount Decimal?   @db.Decimal(10, 2)
  startDate   DateTime?
  endDate     DateTime?
  usageLimit  Int?
  usedCount   Int        @default(0)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  orders Order[] // back relation
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int // 1-5
  comment    String?
  images     String[] // URLs
  isVerified Boolean  @default(false) // purchased or not
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // e.g., "order_status", "promotion"
  title     String
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------------
// 8. CART & WISHLIST
// -------------------------------------------------------------------

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String // link to CustomerProfile.id
  variantId  String
  addedAt    DateTime @default(now())

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant  ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([customerId, variantId])
}

// -------------------------------------------------------------------
// 9. CMS & THEME
// -------------------------------------------------------------------

model HomepageSection {
  id        String    @id @default(cuid())
  type      String // e.g., "hero", "category_grid", "product_carousel"
  title     String?
  subtitle  String?
  config    Json // all section-specific settings
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ThemeConfig {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "primary_color", "heading_font"
  value       Json // flexible value (string, number, object)
  description String?
  updatedAt   DateTime @updatedAt
}

model Menu {
  id        String   @id @default(cuid())
  name      String // e.g., "main_nav", "footer_links"
  items     Json // array of menu items
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CMSPage {
  id             String   @id @default(cuid())
  slug           String   @unique // e.g., "about-us", "privacy-policy"
  title          String
  content        String   @db.Text
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// -------------------------------------------------------------------
// 10. AUDIT & LOGS
// -------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // e.g., "CREATE_PRODUCT", "UPDATE_ORDER"
  entity    String // e.g., "Product", "Order"
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model WebhookLog {
  id          String    @id @default(cuid())
  provider    String // "payment", "courier"
  event       String // e.g., "payment_success", "tracking_update"
  payload     Json
  signature   String?
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
}
